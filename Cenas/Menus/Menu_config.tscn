[sub_resource type="GDScript" id="GDScript_n81uv"]
script/source = "extends Control

# Defina os caminhos das cenas como strings 
var scenes: Dictionary = {
	\"video\": \"\",
	\"audio\": \"res://Cenas/Menus/audio_menu.tscn\",
	\"controles\": \"\",
	\"creditos\": \"\"
}

func _ready() -> void:
	for node in get_tree().get_nodes_in_group(\"botoes_config\"):
		if node is Button:
			node.pressed.connect(Callable(self, \"_on_pressed\").bind(node))
			if node.has_signal(\"mouse_entered\"):
				node.mouse_entered.connect(Callable(self, \"_on_hover\").bind(node, true))
			if node.has_signal(\"mouse_exited\"):
				node.mouse_exited.connect(Callable(self, \"_on_hover\").bind(node, false))
		else:
			push_warning(\"%s no grupo 'botoes_config' não é Button.\" % str(node))

func _on_pressed(button: Button) -> void:
	var key: String = button.name
	if not scenes.has(key):
		push_warning(\"Nenhuma cena configurada para: %s\" % key)
		return
	var target: String = scenes[key] # <- aqui declaramos explicitamente String
	if target != \"\":
		var err: int = get_tree().change_scene_to_file(target)
		if err != OK:
			push_error(\"Erro ao trocar cena (%s): %s\" % [key, str(err)])
	else:
		push_warning(\"Valor inválido para scenes['%s'] ou caminho vazio.\" % key)

func _on_hover(button: Button, entered: bool) -> void:
	button.scale = Vector2(1.05, 1.05) if entered else Vector2.ONE
"

